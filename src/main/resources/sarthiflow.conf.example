sarthiflow {
  database-path = "data/sarthiflow.db"

  reader {
    inputs = ["sample-data/sample-logs.txt"]
    format = "iso8583"
    mode = "batch"
    workers = 4
    poll-interval-ms = 1000
  }

  blueprint {
    name = "iso8583-tat"
    correlation-key-field = "correlation_key"
    request-type-field = "direction"
    response-type-field = "direction"
    request-value = "REQ"
    response-value = "RESP"
    timestamp-field = "timestamp"
    dimensions = ["channel", "response_code"]
    granularity = "1m"
    correlation-timeout-seconds = 3600
    response-status-field = "response_code"
    success-values = ["000"]
    metrics = [
      { name = "transaction.latency", type = "HISTOGRAM", source = "LATENCY_MS" }
      { name = "transaction.count", type = "COUNTER", source = "COUNT" }
      { name = "transaction.success_count", type = "COUNTER", source = "SUCCESS_COUNT" }
      { name = "transaction.error_count", type = "COUNTER", source = "ERROR_COUNT" }
      { name = "transaction.latency.p95", type = "GAUGE", source = "P95_LATENCY_MS" }
      { name = "transaction.latency.p99", type = "GAUGE", source = "P99_LATENCY_MS" }
      { name = "transaction.success_rate", type = "RATE", source = "SUCCESS_RATE" }
      { name = "transaction.error_rate", type = "RATE", source = "ERROR_RATE" }
      { name = "transaction.throughput_per_second", type = "RATE", source = "THROUGHPUT_PER_SECOND" }
    ]
  }

  sender {
    endpoint = "http://localhost:4318/v1/metrics"
    token-env = "OTLP_TOKEN"
    mode = "batch"
    poll-interval-ms = 5000
    batch-size = 10000
  }
}